{
  "name": "@extend-ai/react-docx-wasm",
  "private": true,
  "version": "0.1.0",
  "description": "Rust/WASM DOCX parser for react-docx",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "pkg"],
  "scripts": {
    "build:wasm": "node scripts/build-wasm.mjs",
    "build:js": "tsup src/index.ts --format esm,cjs --dts --sourcemap --clean --shims && cp src/docx_wasm_bg.wasm dist/docx_wasm_bg.wasm && cp dingbat-to-unicode-LICENSE dist/dingbat-to-unicode-LICENSE",
    "build": "pnpm run build:wasm && pnpm run build:js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist pkg"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.8.3"
  }
}
